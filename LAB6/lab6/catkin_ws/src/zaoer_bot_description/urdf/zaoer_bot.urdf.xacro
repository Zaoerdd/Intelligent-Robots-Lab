<?xml version="1.0"?>
<robot name="zaoer_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find zaoer_bot_description)/urdf/common_macros.xacro"/>

  <xacro:property name="base_length" value="0.42"/>
  <xacro:property name="base_width" value="0.28"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="base_mass" value="8.5"/>

  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.45"/>
  <xacro:property name="wheel_y" value="0.19"/>

  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="base_z" value="${wheel_radius + base_height / 2.0}"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_z}"/>
  <xacro:property name="caster_z" value="${caster_radius - base_z}"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>

    <visual>
      <origin xyz="0.00 0 0.16" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>

    <visual>
      <origin xyz="0.08 0 0.24" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.10"/>
      </geometry>
      <material name="head_cream"/>
    </visual>

    <visual>
      <origin xyz="0.18 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.12 0.09"/>
      </geometry>
      <material name="trim_orange"/>
    </visual>

    <visual>
      <origin xyz="-0.16 0 0.00" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.18 0.12"/>
      </geometry>
      <material name="trim_green"/>
    </visual>

    <visual>
      <origin xyz="0.00 0.19 0.03" rpy="0 0 ${pi / 2.0}"/>
      <geometry>
        <cylinder radius="0.026" length="0.16"/>
      </geometry>
      <material name="head_cream"/>
    </visual>

    <visual>
      <origin xyz="0.00 -0.19 0.03" rpy="0 0 ${pi / 2.0}"/>
      <geometry>
        <cylinder radius="0.026" length="0.16"/>
      </geometry>
      <material name="head_cream"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia mass="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <xacro:wheel name="left_wheel" x="0.00" y="${wheel_y}" z="${wheel_z}" radius="${wheel_radius}" length="${wheel_width}" mass="${wheel_mass}"/>
  <xacro:wheel name="right_wheel" x="0.00" y="${-wheel_y}" z="${wheel_z}" radius="${wheel_radius}" length="${wheel_width}" mass="${wheel_mass}"/>
  <xacro:caster_ball name="rear_caster" x="-0.15" y="0.0" z="${caster_z}" radius="${caster_radius}" mass="0.15"/>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.19 0 0.24" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.08 0.04 0.04"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.04 0.04"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="0.15" x="0.08" y="0.04" z="0.04"/>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.10 0 0.36" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.20" radius="0.05" length="0.05"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor type="camera" name="front_camera_sensor">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <visualize>true</visualize>
      <camera name="front_camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>12.0</far>
        </clip>
      </camera>
      <plugin name="zaoer_camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_optical_frame</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Gray</material>
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>15.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-1.5708</min_angle>
            <max_angle>1.5708</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="zaoer_lidar_controller" filename="libgazebo_ros_laser.so">
        <topicName>scan</topicName>
        <frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="zaoer_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>50.0</updateRate>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>${2.0 * wheel_y}</wheelSeparation>
      <wheelDiameter>${2.0 * wheel_radius}</wheelDiameter>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishWheelJointState>true</publishWheelJointState>
      <publishTf>true</publishTf>
      <wheelTorque>20</wheelTorque>
      <wheelAcceleration>1.5</wheelAcceleration>
      <legacyMode>false</legacyMode>
    </plugin>
  </gazebo>
</robot>
